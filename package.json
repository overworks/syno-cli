{
  "name": "syno-cli-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for syno-cli: TypeScript SDK + CLI for the Synology DSM Web API",
  "license": "MIT",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@types/node": "20.14.10",
    "tsx": "4.16.2",
    "turbo": "2.0.6",
    "typescript": "5.5.3",
    "vitest": "1.6.0"
  }
}
