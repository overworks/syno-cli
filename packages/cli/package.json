{
  "name": "@overworks/syno-cli",
  "version": "0.1.1",
  "description": "Command-line interface for the Synology DSM Web API",
  "license": "MIT",
  "author": "Minhyung Park",
  "homepage": "https://github.com/overworks/syno-cli/tree/0.x/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/overworks/syno-cli.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/overworks/syno-cli/issues",
  "keywords": [
    "synology",
    "dsm",
    "nas",
    "webapi",
    "cli",
    "synology-cli",
    "filestation",
    "downloadstation"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "bin": {
    "syno": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@overworks/syno-core": "workspace:*",
    "@overworks/syno-ds": "workspace:*",
    "@overworks/syno-file": "workspace:*",
    "@overworks/syno-system": "workspace:*",
    "commander": "12.1.0"
  }
}
